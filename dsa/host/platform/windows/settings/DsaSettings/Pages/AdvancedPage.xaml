<Page
    x:Class="Dsa.Settings.Pages.AdvancedPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,8,36,24" MaxWidth="1000">
            <TextBlock Text="{l:Text AdvancedTitle.Text}" Style="{StaticResource PageTitle}" />

            <ui:InfoBar Title="{l:Text SettingsErrorBar.Title}" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Clipboard24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text ClipboardCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text ClipboardCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ClipboardSwitch" IsChecked="{Binding Clipboard, Mode=OneWay}"
                                 IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnClipboardToggled" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Snooze24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text FreezeCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text FreezeCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="FreezeSwitch" IsChecked="{Binding Freeze, Mode=OneWay}"
                                 IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnFreezeToggled" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Link24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text LinksCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text LinksCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="LinksSwitch" IsChecked="{Binding LinksInAndroid, Mode=OneWay}"
                                 IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnLinksToggled" />
            </ui:CardControl>

            <TextBlock Text="{l:Text RunModeHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text ContinuousCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text ContinuousCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ContinuousSwitch" IsChecked="{Binding Continuous, Mode=OneWay}"
                                 IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnContinuousToggled" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text StopAfterCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text StopAfterCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="StopAfterBox" MinWidth="160" DisplayMemberPath="Label"
                          ItemsSource="{Binding StopAfterChoices, Mode=OneWay}"
                          SelectedIndex="{Binding SelectedStopAfterIndex, Mode=OneWay}"
                          IsEnabled="{Binding CanChangeStopAfter, Mode=OneWay}" SelectionChanged="OnStopAfterChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Alert24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text KeepForNotificationsCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text KeepForNotificationsCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="KeepForNotificationsSwitch" IsChecked="{Binding KeepForNotifications, Mode=OneWay}"
                                 IsEnabled="{Binding CanChangeStopAfter, Mode=OneWay}" Click="OnKeepForNotificationsToggled" />
            </ui:CardControl>

            <TextBlock Text="{l:Text ResetDataHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:InfoBar Title="{l:Text ResetDoneBar.Title}" Message="{l:Text ResetDoneBar.Message}"
                        Severity="Success" IsClosable="False" IsOpen="{Binding ResetDone, Mode=OneWay}" Margin="0,0,0,4" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowReset24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text ResetDataCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text ResetDataCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                     Visibility="{Binding IsResetting, Converter={StaticResource Visible}}" />
                    <ui:Button Content="{l:Text ResetDataButton.Content}" Appearance="Danger" Click="OnResetData"
                               IsEnabled="{Binding CanResetData, Mode=OneWay}" />
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="{l:Text ArmHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Apps24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text ArmCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ArmStatus, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                        <TextBlock Text="{Binding ArmAbis, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                        <TextBlock Text="{l:Text ArmCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ArmTranslationSwitch" IsChecked="{Binding ArmTranslation, Mode=OneWay}"
                                 IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnArmTranslationToggled" />
            </ui:CardControl>
            <ui:InfoBar Title="{l:Text ArmRestartBar.Title}" Message="{l:Text ArmRestartBar.Message}"
                        Severity="Informational" IsClosable="False"
                        IsOpen="{Binding ArmRestartNeeded, Mode=OneWay}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Delete24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text ArmRemoveCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text ArmRemoveCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Text ArmRemoveButton.Content}" Click="OnRemoveArmTranslation"
                           IsEnabled="{Binding CanRemoveArmTranslation, Mode=OneWay}" />
            </ui:CardControl>

            <TextBlock Text="{l:Text DeveloperHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DeveloperBoard24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text DeveloperModeCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text DeveloperModeCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DeveloperModeSwitch" IsChecked="{Binding DeveloperMode, Mode=OneWay}"
                                 IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnDeveloperModeToggled" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text AdbCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text AdbCard.Description}" Style="{StaticResource CardDescription}" />
                        <TextBox Text="{Binding AdbConnect, Mode=OneWay}" FontFamily="Consolas" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" Padding="0,4,0,0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Text AdbPortLabel.Text}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="AdbPortBox" Width="90" Text="{Binding AdbPort, Mode=OneWay}"
                             IsEnabled="{Binding CanChange, Mode=OneWay}" LostFocus="OnAdbPortChanged"
                             KeyDown="OnAdbPortKeyDown" />
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="{l:Text DiagnosticsHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Bug24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Text InputTraceCard.Header}" Style="{StaticResource CardTitle}" />
                            <ui:SymbolIcon Symbol="Shield24" Margin="6,0,0,0" ToolTip="{l:Text AdminShield.ToolTip}" />
                        </StackPanel>
                        <TextBlock Text="{l:Text InputTraceCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Text ChangeAsAdmin.Content}" Icon="{ui:SymbolIcon Shield24}" Margin="0,0,12,0"
                               Visibility="{Binding TracesNeedAdministrator, Converter={StaticResource Visible}}"
                               Click="OnInputTraceAsAdministrator" />
                    <ui:ToggleSwitch x:Name="InputTraceSwitch" IsChecked="{Binding InputTrace, Mode=OneWay}"
                                     IsEnabled="{Binding CanChangeTraces, Mode=OneWay}" Click="OnInputTraceToggled" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ResizeLarge24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Text ResizeTraceCard.Header}" Style="{StaticResource CardTitle}" />
                            <ui:SymbolIcon Symbol="Shield24" Margin="6,0,0,0" ToolTip="{l:Text AdminShield.ToolTip}" />
                        </StackPanel>
                        <TextBlock Text="{l:Text ResizeTraceCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Text ChangeAsAdmin.Content}" Icon="{ui:SymbolIcon Shield24}" Margin="0,0,12,0"
                               Visibility="{Binding TracesNeedAdministrator, Converter={StaticResource Visible}}"
                               Click="OnResizeTraceAsAdministrator" />
                    <ui:ToggleSwitch x:Name="ResizeTraceSwitch" IsChecked="{Binding ResizeTrace, Mode=OneWay}"
                                     IsEnabled="{Binding CanChangeTraces, Mode=OneWay}" Click="OnResizeTraceToggled" />
                </StackPanel>
            </ui:CardControl>
            <TextBlock Text="{l:Text DiagnosticsNote.Text}" Style="{StaticResource Note}" />

            <TextBlock Text="{l:Text LogsHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardAction Icon="{ui:SymbolIcon Folder24}" Click="OnOpenUserLogs" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{l:Text UserLogsCard.Header}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{l:Text UserLogsCard.Description}" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction Icon="{ui:SymbolIcon FolderPeople24}" Click="OnOpenServiceLogs">
                <StackPanel>
                    <TextBlock Text="{l:Text ServiceLogsCard.Header}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding LogDir, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </ui:CardAction>

            <TextBlock Text="{l:Text CommandLineHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon WindowConsole20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text CommandLineCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text CommandLineCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBox Text="dsa status | dsa settings | dsa memory" FontFamily="Consolas" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
