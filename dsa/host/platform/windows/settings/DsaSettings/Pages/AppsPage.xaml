<Page
    x:Class="Dsa.Settings.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,8,36,24" MaxWidth="1000">
            <Grid>
                <TextBlock Text="{l:Text AppsTitle.Text}" Style="{StaticResource PageTitle}" />
                <ui:Button Content="{l:Text AppsRefreshButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh"
                           IsEnabled="{Binding IsIdle, Mode=OneWay}" />
            </Grid>
            <TextBlock Text="{l:Text AppsIntro.Text}" Style="{StaticResource Note}" />

            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <ui:InfoBar Title="{l:Text AppsErrorBar.Title}" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />
            <ui:InfoBar Title="{l:Text AppsDoneBar.Title}" Severity="Success" IsClosable="False"
                        IsOpen="{Binding HasMessage, Mode=OneWay}" Message="{Binding Message, Mode=OneWay}" />

            <!-- Android's own list of apps, as WSA's "Manage apps" opened it. -->
            <ui:CardAction Margin="0,16,0,0" Icon="{ui:SymbolIcon AppsList24}" Click="OnManage"
                           IsEnabled="{Binding IsIdle, Mode=OneWay}">
                <StackPanel>
                    <TextBlock Text="{l:Text AppsManageCard.Title}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{l:Text AppsManageCard.Description}" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </ui:CardAction>

            <TextBlock Text="{l:Text AppsInstalledHeader.Text}" Style="{StaticResource SectionHeader}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="{l:Text AppsSearch.PlaceholderText}"
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                            Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" Text="{Binding Count, Mode=OneWay}" Style="{StaticResource CardDescription}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{l:Text AppsNone.Text}" Style="{StaticResource Note}"
                       Visibility="{Binding HasNoApps, Converter={StaticResource Visible}}" />
            <TextBlock Text="{l:Text AppsNoMatch.Text}" Style="{StaticResource Note}"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="24"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource Visible}}" />
                                        <Image Source="{Binding Icon, TargetNullValue={x:Null}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Size}" Style="{StaticResource CardDescription}"
                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                <ui:Button Content="{l:Text AppsOpenButton.Content}" Tag="{Binding Package}" Click="OnOpen"
                                           Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,0"
                                           AutomationProperties.HelpText="{Binding Label}" />
                                <ui:Button Content="{l:Text AppsInfoButton.Content}" Tag="{Binding Package}" Click="OnInfo"
                                           Icon="{ui:SymbolIcon Info24}" Margin="0,0,8,0"
                                           AutomationProperties.HelpText="{Binding Label}" />
                                <ui:Button Content="{l:Text AppsUninstallButton.Content}" Tag="{Binding Package}" Click="OnUninstall"
                                           Icon="{ui:SymbolIcon Delete24}" IsEnabled="{Binding CanUninstall}"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="{Binding UninstallTip, TargetNullValue={x:Null}}"
                                           AutomationProperties.HelpText="{Binding Label}" />
                                <!-- The app's windows: whether the user resizes them, and the size they open at. -->
                                <ui:ToggleSwitch Content="{l:Text AppsResizable.Content}" Tag="{Binding Package}"
                                                 IsChecked="{Binding Resizable, Mode=OneWay}" Click="OnResizable"
                                                 Margin="16,0,8,0" VerticalAlignment="Center"
                                                 ToolTip="{l:Text AppsResizable.ToolTip}"
                                                 AutomationProperties.HelpText="{Binding Label}" />
                                <ComboBox Tag="{Binding Package}" MinWidth="200" VerticalAlignment="Center"
                                          ItemsSource="{Binding DataContext.StartSizeChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          DisplayMemberPath="Label"
                                          SelectedIndex="{Binding StartSizeIndex, Mode=OneWay}"
                                          SelectionChanged="OnStartSize"
                                          ToolTip="{l:Text AppsStartSize.ToolTip}"
                                          AutomationProperties.Name="{l:Text AppsStartSize.ToolTip}"
                                          AutomationProperties.HelpText="{Binding Label}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
