<!--
    The APK Installer's window, laid out as App Installer lays out an app package: the app's
    name large at the top left with its publisher and version under it, its icon at the top
    right, what it asks for under "Capabilities", and a footer with "Launch when ready" on the
    left and the main button on the right. While it installs, the footer's left side shows the
    progress bar and what is happening; then the window says how it went.
-->
<ui:FluentWindow
    x:Class="Dsa.ApkInstaller.InstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="600"
    Height="580"
    MinWidth="480"
    MinHeight="420"
    FontFamily="{StaticResource TextFont}"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ResizeMode="CanMinimize"
    AllowDrop="True"
    AutomationProperties.AutomationId="ApkInstallWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="32" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/apk-installer.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="{StaticResource ContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The app: its name, package, publisher and version on the left, its icon on the
                 right. -->
            <Grid x:Name="Header" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource AppNameText}"
                               AutomationProperties.AutomationId="HeroTitle" />
                    <TextBlock x:Name="HeroPackage" Style="{StaticResource DetailLine}"
                               AutomationProperties.AutomationId="HeroPackage" />
                    <TextBlock x:Name="PublisherText" Style="{StaticResource DetailLine}"
                               AutomationProperties.AutomationId="PublisherText" />
                    <TextBlock x:Name="VersionChip" Style="{StaticResource DetailLine}"
                               AutomationProperties.AutomationId="VersionChip" />
                </StackPanel>
                <Image x:Name="AppIcon" Grid.Column="1" VerticalAlignment="Top"
                       Width="{StaticResource AppIconSize}" Height="{StaticResource AppIconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.AutomationId="AppIcon" />
            </Grid>

            <!-- What installing does, and why this PC may not run the app. -->
            <StackPanel x:Name="SummaryPanel" Grid.Row="1" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="SummaryBadge" Symbol="ErrorCircle24" Filled="True" FontSize="20"
                                   Margin="0,0,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="SummaryText" Grid.Column="1" Style="{StaticResource BodyText}"
                               AutomationProperties.AutomationId="SummaryText" />
                </Grid>
                <ui:InfoBar x:Name="CompatibilityBar" Margin="0,12,0,0" Severity="Warning" IsClosable="False"
                            IsOpen="False" AutomationProperties.AutomationId="CompatibilityWarning" />
            </StackPanel>

            <Grid Grid.Row="2">
                <!-- Reading the file. -->
                <StackPanel x:Name="ReadingPanel" Margin="0,20,0,0">
                    <TextBlock x:Name="ReadingText" Style="{StaticResource BodyText}" />
                    <ProgressBar Margin="0,12,0,0" IsIndeterminate="True" />
                </StackPanel>

                <!-- What the app asks for, then the rest of what the file says. -->
                <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Focusable="False"
                              AutomationProperties.AutomationId="DetailsScroller">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock x:Name="PermissionsHeader" Style="{StaticResource SectionHeader}"
                                   AutomationProperties.AutomationId="PermissionsHeader" />
                        <ItemsControl x:Name="PermissionList" Focusable="False"
                                      AutomationProperties.AutomationId="PermissionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x2022;" Style="{StaticResource BodyText}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border x:Name="SensitiveChip" Grid.Column="2" Margin="8,0,0,0" Padding="8,2"
                                                VerticalAlignment="Top" CornerRadius="4"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{DynamicResource SensitiveText}" Style="{StaticResource CaptionText}"
                                                       TextWrapping="NoWrap" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Sensitive}" Value="False">
                                            <Setter TargetName="SensitiveChip" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="DetailsHeader" Style="{StaticResource SectionHeader}" />
                        <ItemsControl x:Name="FactList" Focusable="False" AutomationProperties.AutomationId="FactList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0,2,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TrademarkText" Style="{StaticResource CaptionText}" Margin="0,16,0,0"
                                   AutomationProperties.AutomationId="TrademarkText" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Installed, or why not. -->
                <Grid x:Name="ResultPanel" Margin="0,20,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="ResultGlyph" Symbol="CheckmarkCircle24" Filled="True" FontSize="24"
                                   VerticalAlignment="Top" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionHeader}" Margin="0,2,0,4"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ResultTitle" />
                        <TextBlock x:Name="ResultText" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="ResultText" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer: "Launch when ready", or the progress while installing, on the left; the
             buttons on the right, the main one last. -->
        <Border Grid.Row="2" x:Name="Footer" Padding="{StaticResource FooterPadding}" BorderThickness="0,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="LaunchWhenReady" Grid.Column="0" VerticalAlignment="Center" IsChecked="True"
                          AutomationProperties.AutomationId="LaunchWhenReady" />

                <StackPanel x:Name="ProgressPanel" Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap"
                                   AutomationProperties.AutomationId="ProgressPercent" />
                        <TextBlock x:Name="ProgressTitle" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ProgressTitle" />
                    </DockPanel>
                    <ProgressBar x:Name="Progress" Margin="0,8,0,0" Maximum="100"
                                 AutomationProperties.AutomationId="ProgressBar" />
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ProgressDetail" />
                </StackPanel>

                <StackPanel x:Name="Buttons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ui:Button x:Name="CancelButton" Margin="8,0,0,0" MinWidth="{StaticResource PrimaryButtonMinWidth}"
                               Click="OnCancel" AutomationProperties.AutomationId="CancelButton" />
                    <ui:Button x:Name="CloseButton" Margin="8,0,0,0" MinWidth="{StaticResource PrimaryButtonMinWidth}"
                               Click="OnClose" AutomationProperties.AutomationId="CloseButton" />
                    <ui:Button x:Name="OpenButton" Appearance="Primary" Margin="8,0,0,0"
                               MinWidth="{StaticResource PrimaryButtonMinWidth}"
                               Click="OnOpen" AutomationProperties.AutomationId="OpenButton" />
                    <ui:Button x:Name="InstallButton" Appearance="Primary" Margin="8,0,0,0"
                               MinWidth="{StaticResource PrimaryButtonMinWidth}"
                               Click="OnInstall" AutomationProperties.AutomationId="InstallButton" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
