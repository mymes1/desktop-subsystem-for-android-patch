<Application
    x:Class="Dsa.ApkInstaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- The title bar's colours, active and inactive, after the library's style it extends. -->
                <ResourceDictionary Source="/TitleBarStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The Windows type ramp, as App Installer uses it: Segoe UI Variable (Display for
                 the app's name, Text for the rest), Segoe UI where Windows 10 lacks it, and
                 Malgun Gothic for Korean.
                   Title       28 px, 36 px line   the app's name
                   Body Strong 14 px, 20 px line   section headers
                   Body        14 px, 20 px line   publisher, version, capabilities
                   Caption     12 px, 16 px line   permission names, the notice
                 Malgun Gothic has no Semibold, so a Semibold request draws Korean in its Bold, and
                 App.OnStartup points the strong fonts at the regular ones in Korean. -->
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="StrongTextFont">Segoe UI Variable Text Semibold, Segoe UI Semibold, Malgun Gothic</FontFamily>
            <FontFamily x:Key="StrongDisplayFont">Segoe UI Variable Display Semibold, Segoe UI Semibold, Malgun Gothic</FontFamily>

            <!-- App Installer's spacing: 32 px from the window's sides, the icon's tile 106 px at
                 the top right with the icon inside it, and the bottom row, without a divider or
                 a band of its own, 20 px above and 24 px below its controls. -->
            <Thickness x:Key="ContentMargin">32,12,32,0</Thickness>
            <Thickness x:Key="FooterPadding">32,20,32,24</Thickness>
            <sys:Double x:Key="AppIconTileSize">106</sys:Double>
            <sys:Double x:Key="AppIconSize">84</sys:Double>
            <sys:Double x:Key="PrimaryButtonMinWidth">120</sys:Double>

            <!-- The icon's tile shows whether the window has the focus, as its title bar does.
                 Active, it is a lifted card: a near-white layer in the light theme and a raised
                 grey in the dark one, each with the theme's faint card stroke. Inactive, it
                 settles back to a dimmed grey without the stroke. High contrast draws it in the
                 theme's window colours, with the text colour as its edge while active and the
                 disabled text colour while not.
                 The window's resources carry the colours under the names without a suffix:
                 TitleBarActivation copies the .Light, .Dark or .HighContrast ones there and
                 again whenever the theme changes. -->
            <SolidColorBrush x:Key="AppIconTileActiveBackground.Light" Color="#FCFCFC" />
            <SolidColorBrush x:Key="AppIconTileActiveBorder.Light" Color="#14000000" />
            <SolidColorBrush x:Key="AppIconTileInactiveBackground.Light" Color="#E6E6E6" />
            <SolidColorBrush x:Key="AppIconTileInactiveBorder.Light" Color="Transparent" />
            <SolidColorBrush x:Key="AppIconTileActiveBackground.Dark" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AppIconTileActiveBorder.Dark" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppIconTileInactiveBackground.Dark" Color="#2B2B2B" />
            <SolidColorBrush x:Key="AppIconTileInactiveBorder.Dark" Color="Transparent" />
            <SolidColorBrush x:Key="AppIconTileActiveBackground.HighContrast" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
            <SolidColorBrush x:Key="AppIconTileActiveBorder.HighContrast" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
            <SolidColorBrush x:Key="AppIconTileInactiveBackground.HighContrast" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
            <SolidColorBrush x:Key="AppIconTileInactiveBorder.HighContrast" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
            <Style x:Key="AppIconTile" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource AppIconTileActiveBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppIconTileActiveBorder}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                        <Setter Property="Background" Value="{DynamicResource AppIconTileInactiveBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppIconTileInactiveBorder}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AppNameText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource StrongDisplayFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- A line under the app's name: exactly one 20 px line, as App Installer's rows sit,
                 about 4 px of air between one line's text and the next. No margin: a margin on
                 each line stacks on top of the line's own leading. BlockLineHeight holds the
                 line at 20 px; the default stacking lets a font with a taller line box (Segoe UI
                 Variable's, or a fallback's) push every row further apart. -->
            <Style x:Key="DetailLine" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- A line's label, in the column before the values. -->
            <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource DetailLine}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource StrongTextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Margin" Value="0,20,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- The title line of a notice: Body Strong, without a section header's margins. -->
            <Style x:Key="NoticeTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- A notice: App Installer's InfoBar, the icon in its own column on the title line
                 and the title and the text in one column beside it. -->
            <Style x:Key="NoticeBox" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>
            <!-- The More link: words in the accent colour, a button to keyboard and automation. -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="0,2">
                                <ContentPresenter TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
