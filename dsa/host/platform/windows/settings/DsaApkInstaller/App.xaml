<Application
    x:Class="Dsa.ApkInstaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- The Windows type ramp, as App Installer uses it: Segoe UI Variable (Display for
                 the app's name, Text for the rest), Segoe UI where Windows 10 lacks it, and
                 Malgun Gothic for Korean.
                   Title       28 px, 36 px line   the app's name
                   Body Strong 14 px, 20 px line   section headers
                   Body        14 px, 20 px line   publisher, version, capabilities
                   Caption     12 px, 16 px line   permission names, the notice
                 Strong text names a Semibold face and keeps FontWeight Normal: Malgun Gothic has
                 no Semibold, so FontWeight SemiBold would pick its Bold for Korean. -->
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="StrongTextFont">Segoe UI Variable Text Semibold, Segoe UI Semibold, Malgun Gothic</FontFamily>
            <FontFamily x:Key="StrongDisplayFont">Segoe UI Variable Display Semibold, Segoe UI Semibold, Malgun Gothic</FontFamily>

            <!-- App Installer's spacing: 32 px from the window's sides, the icon tile 88 px at
                 the top right, sections 20 px apart, and the footer on its own layer under the
                 content, 20 px above and 24 px below its controls. -->
            <Thickness x:Key="ContentMargin">32,12,32,0</Thickness>
            <Thickness x:Key="FooterPadding">32,20,32,24</Thickness>
            <sys:Double x:Key="AppIconSize">88</sys:Double>
            <sys:Double x:Key="PrimaryButtonMinWidth">120</sys:Double>

            <Style x:Key="AppNameText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource StrongDisplayFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="DetailLine" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource StrongTextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Margin" Value="0,20,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
