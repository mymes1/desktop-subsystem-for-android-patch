# The DSA service: runs the Android VM and the local API at /run/dsa/host.sock.
[Unit]
Description=Desktop Subsystem for Android service
Documentation=https://github.com/thisisthepy/desktop-subsystem-for-android
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/dsa/bin/dsa-linux-hostd serve /etc/dsa/dsa-hostd.json
RuntimeDirectory=dsa
RuntimeDirectoryMode=0755
StateDirectory=dsa
StateDirectoryMode=0755
LogsDirectory=dsa
Restart=on-failure
RestartSec=2
# The VM needs /dev/kvm and /dev/vhost-vsock, and serves each user's folders with that user's
# own file system identity, so the service keeps the capabilities for that and nothing more.
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/vhost-vsock rw
DeviceAllow=/dev/vhost-net rw
DeviceAllow=/dev/net/tun rw
# Advanced networking hands the VM a macvtap on the LAN, a /dev/tapN of its own.
DeviceAllow=char-macvtap rw
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=full
# The repository entries the package wrote, which follow the release channel the settings
# choose. A folder this distribution does not have is skipped (the leading "-").
ReadWritePaths=-/etc/apt/sources.list.d -/etc/yum.repos.d -/etc/zypp/repos.d
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
