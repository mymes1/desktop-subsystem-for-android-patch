<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What dsa-hostd needs from macOS. Sign it with:
    codesign --force --sign <identity or "-" for ad hoc> \
      --entitlements dsa-hostd.entitlements --options runtime dsa-hostd
  com.apple.security.virtualization lets the process create VMs with Apple's
  Virtualization framework; without it the framework refuses every configuration.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
