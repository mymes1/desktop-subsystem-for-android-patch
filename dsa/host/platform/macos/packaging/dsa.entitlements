<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Android VM runs on Virtualization.framework, which only a program carrying this
	     entitlement may use. -->
	<key>com.apple.security.virtualization</key>
	<true/>
	<!-- Under the hardened runtime, a program reaches the camera, the microphone and the
	     location only with these; the user still allows each one in the privacy settings. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- The graphics renderer and MoltenVK are loaded at run time from inside the bundle,
	     signed by the same team; the library validation exception covers an ad hoc signed
	     development build, whose libraries carry no team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
