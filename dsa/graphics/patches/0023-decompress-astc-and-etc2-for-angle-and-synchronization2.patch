+    imageBarriers.back().dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    imageBarriers.back().dstAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    imageBarriers.back().newLayout = VK_IMAGE_LAYOUT_GENERAL;
