+
+void ResourceTracker::readBackAfterFence(VkEncoder* enc, VkDevice device, VkFence fence) {
+    if (usingDirectMapping()) return;
+    // Only the first success after a submit reads back: an app that polls a signalled fence
+    // would otherwise copy every coherent allocation back at each poll.
+    uint64_t submits = 0;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkFence.find(fence);
+        if (it == info_VkFence.end() || it->second.readBackSubmits == it->second.submits) {
+            return;
+        }
+        submits = it->second.submits;
+    }
+    invalidateShadowedMemory(enc, device);
+    // Only once the copies hold the writes: another thread that sees the fence signalled
+    // meanwhile reads back too rather than reading stale memory.
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkFence.find(fence);
+    if (it != info_VkFence.end() && it->second.readBackSubmits < submits) {
+        it->second.readBackSubmits = submits;
+    }
+}
+
+void ResourceTracker::readBackAfterSemaphoreValue(VkEncoder* enc, VkDevice device,
+                                                  VkSemaphore semaphore, uint64_t value) {
+    if (usingDirectMapping()) return;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkSemaphore.find(semaphore);
+        if (it != info_VkSemaphore.end() && it->second.readBackValue >= value) return;
+    }
+    invalidateShadowedMemory(enc, device);
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkSemaphore.find(semaphore);
+    if (it != info_VkSemaphore.end() && it->second.readBackValue < value) {
+        it->second.readBackValue = value;
+    }
+}
