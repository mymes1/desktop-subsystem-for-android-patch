+void ResourceTracker::on_vkCreateFramebuffer(const VkFramebufferCreateInfo* pCreateInfo,
+                                             VkFramebuffer framebuffer) {
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+    if (!pCreateInfo || !mHasCpuReadback.load(std::memory_order_relaxed)) return;
+    if ((pCreateInfo->flags & VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT) != 0 ||
+        !pCreateInfo->pAttachments) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    std::vector<uint64_t> memories;
+    for (uint32_t i = 0; i < pCreateInfo->attachmentCount; ++i) {
+        auto it = mCpuReadbackViews.find((uint64_t)pCreateInfo->pAttachments[i]);
+        if (it != mCpuReadbackViews.end()) {
+            memories.push_back(it->second);
+        }
+    }
+    if (!memories.empty()) {
+        mCpuReadbackFramebuffers[(uint64_t)framebuffer] = std::move(memories);
+    }
+#else
+    (void)pCreateInfo;
+    (void)framebuffer;
+#endif
+}
+
+void ResourceTracker::on_vkDestroyFramebuffer(VkFramebuffer framebuffer) {
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+    if (!mHasCpuReadback.load(std::memory_order_relaxed)) return;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    mCpuReadbackFramebuffers.erase((uint64_t)framebuffer);
+#else
+    (void)framebuffer;
+#endif
+}
+
+void ResourceTracker::noteImageReadback(VkCommandBuffer commandBuffer, VkImage image) {
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+    if (!mHasCpuReadback.load(std::memory_order_relaxed)) return;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto imgIt = info_VkImage.find(image);
+    if (imgIt == info_VkImage.end()) return;
+    const uint64_t mem = (uint64_t)imgIt->second.currentBacking;
+    if (mem == 0 || !mCpuReadback.contains(mem)) return;
+    auto& list = info_VkCommandBuffer[commandBuffer].cpuReadbackMemories;
+    for (uint64_t existing : list) {
+        if (existing == mem) return;
+    }
+    list.push_back(mem);
+#else
+    (void)commandBuffer;
+    (void)image;
+#endif
+}
+
+void ResourceTracker::noteRenderPassReadback(VkCommandBuffer commandBuffer,
+                                             const VkRenderPassBeginInfo* pRenderPassBegin) {
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+    if (!pRenderPassBegin || !mHasCpuReadback.load(std::memory_order_relaxed)) return;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto& list = info_VkCommandBuffer[commandBuffer].cpuReadbackMemories;
+    auto addUnique = [&list](uint64_t mem) {
+        for (uint64_t existing : list) {
+            if (existing == mem) return;
+        }
+        list.push_back(mem);
+    };
+    auto fbIt = mCpuReadbackFramebuffers.find((uint64_t)pRenderPassBegin->framebuffer);
+    if (fbIt != mCpuReadbackFramebuffers.end()) {
+        for (uint64_t mem : fbIt->second) {
+            addUnique(mem);
+        }
+    }
+    const VkRenderPassAttachmentBeginInfo* attachBegin =
+        vk_find_struct_const(pRenderPassBegin, RENDER_PASS_ATTACHMENT_BEGIN_INFO);
+    if (attachBegin && attachBegin->pAttachments) {
+        for (uint32_t i = 0; i < attachBegin->attachmentCount; ++i) {
+            auto viewIt = mCpuReadbackViews.find((uint64_t)attachBegin->pAttachments[i]);
+            if (viewIt != mCpuReadbackViews.end()) {
+                addUnique(viewIt->second);
+            }
+        }
+    }
+#else
+    (void)commandBuffer;
+    (void)pRenderPassBegin;
+#endif
+}
+
+void ResourceTracker::noteRenderingReadback(VkCommandBuffer commandBuffer,
+                                            const VkRenderingInfo* pRenderingInfo) {
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+    if (!pRenderingInfo || !mHasCpuReadback.load(std::memory_order_relaxed)) return;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto& list = info_VkCommandBuffer[commandBuffer].cpuReadbackMemories;
+    auto addView = [this, &list](VkImageView view) {
+        if (view == VK_NULL_HANDLE) return;
+        auto it = mCpuReadbackViews.find((uint64_t)view);
+        if (it == mCpuReadbackViews.end()) return;
+        for (uint64_t existing : list) {
+            if (existing == it->second) return;
+        }
+        list.push_back(it->second);
+    };
+    if (pRenderingInfo->pColorAttachments) {
+        for (uint32_t i = 0; i < pRenderingInfo->colorAttachmentCount; ++i) {
+            addView(pRenderingInfo->pColorAttachments[i].imageView);
+            addView(pRenderingInfo->pColorAttachments[i].resolveImageView);
+        }
+    }
+#else
+    (void)commandBuffer;
+    (void)pRenderingInfo;
+#endif
 }
 
