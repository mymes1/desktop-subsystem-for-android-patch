+void ResourceTracker::on_vkCmdPipelineBarrier2(void* context, VkCommandBuffer commandBuffer,
+                                               const VkDependencyInfo* pDependencyInfo,
+                                               bool khr) {
+    VkEncoder* enc = (VkEncoder*)context;
+    if (!pDependencyInfo || pDependencyInfo->imageMemoryBarrierCount == 0 ||
+        !pDependencyInfo->pImageMemoryBarriers) {
+        if (khr) {
+            enc->vkCmdPipelineBarrier2KHR(commandBuffer, pDependencyInfo, true /* do lock */);
+        } else {
+            enc->vkCmdPipelineBarrier2(commandBuffer, pDependencyInfo, true /* do lock */);
+        }
+        return;
+    }
+
+    std::vector<VkImageMemoryBarrier2> updatedImageMemoryBarriers;
+    updatedImageMemoryBarriers.reserve(pDependencyInfo->imageMemoryBarrierCount);
+    for (uint32_t i = 0; i < pDependencyInfo->imageMemoryBarrierCount; ++i) {
+        VkImageMemoryBarrier2 barrier = pDependencyInfo->pImageMemoryBarriers[i];
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+        if (barrier.srcQueueFamilyIndex != barrier.dstQueueFamilyIndex &&
+            (barrier.srcQueueFamilyIndex == VK_QUEUE_FAMILY_EXTERNAL ||
+             barrier.srcQueueFamilyIndex == VK_QUEUE_FAMILY_FOREIGN_EXT) &&
+            barrier.oldLayout == VK_IMAGE_LAYOUT_UNDEFINED) {
+            barrier.oldLayout = barrier.newLayout;
+        }
+        noteImageReadback(commandBuffer, barrier.image);
+#endif
+        updatedImageMemoryBarriers.push_back(barrier);
+    }
+
+    VkDependencyInfo updatedInfo = *pDependencyInfo;
+    updatedInfo.pImageMemoryBarriers = updatedImageMemoryBarriers.data();
+    if (khr) {
+        enc->vkCmdPipelineBarrier2KHR(commandBuffer, &updatedInfo, true /* do lock */);
+    } else {
+        enc->vkCmdPipelineBarrier2(commandBuffer, &updatedInfo, true /* do lock */);
+    }
+}
