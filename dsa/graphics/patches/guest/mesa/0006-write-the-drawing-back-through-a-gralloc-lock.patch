+// Writes the host's drawing over the buffer through a gralloc CPU lock, the mapping screencap
+// and an ImageReader read the buffer through. The buffer's dma-buf could not be mapped in
+// SurfaceFlinger ("cannot map buffer 18 to write the GPU's drawing into it: Invalid
+// argument", image test run 42562909966), so every screencap stayed blank, while screencap's
+// own lock of the same buffer worked and read zeros. 0 when it wrote the drawing.
+static int writeThroughGralloc(cros_gralloc_handle const* cros_handle,
+                               const native_handle_t* handle, const dsa::ReadbackFormat& format,
+                               const std::vector<uint8_t>& pixels) {
+    // The buffer as it was allocated: the mapper checks a description against the handle.
+    AHardwareBuffer_Desc desc = {};
+    desc.width = cros_handle->width;
+    desc.height = cros_handle->height;
+    desc.layers = 1;
+    desc.format = static_cast<uint32_t>(cros_handle->droid_format);
+    desc.usage = static_cast<uint64_t>(cros_handle->usage);
+    desc.stride = cros_handle->pixel_stride;
+    AHardwareBuffer* ahb = nullptr;
+    // A clone of the handle, imported for this process; the caller's handle stays its own.
+    int result = AHardwareBuffer_createFromHandle(
+        &desc, handle, AHARDWAREBUFFER_CREATE_FROM_HANDLE_METHOD_CLONE, &ahb);
+    if (result != 0 || !ahb) {
+        return result != 0 ? result : -EINVAL;
+    }
+    void* mapped = nullptr;
+    result = AHardwareBuffer_lock(ahb, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &mapped);
+    if (result == 0 && mapped) {
+        // The lock maps the first plane from its offset, at the stride the handle carries.
+        const size_t stride = cros_handle->strides[0];
+        const bool copied = dsa::copyReadbackRows(
+            pixels.data(), pixels.size(), format, cros_handle->width, cros_handle->height,
+            static_cast<uint8_t*>(mapped), stride, stride * cros_handle->height);
+        // Unlocked without a fence: the writes are in the buffer when this returns.
+        AHardwareBuffer_unlock(ahb, nullptr);
+        if (!copied) {
+            result = -EINVAL;
+        }
+    } else if (result == 0) {
+        result = -EINVAL;
+    }
+    AHardwareBuffer_release(ahb);
+    return result;
+}
