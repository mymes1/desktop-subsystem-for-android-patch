+bool MinigbmGralloc::wantsCpuReadback(const native_handle_t* handle) {
+    // With virtio-gpu the kernel moves the drawing into the buffer's memory when a CPU maps it.
+    if (mDevice || !handle) {
+        return false;
+    }
+    cros_gralloc_handle const* cros_handle = reinterpret_cast<cros_gralloc_handle const*>(handle);
+    dsa::ReadbackFormat format;
+    return dsa::wantsCpuReadback(static_cast<uint64_t>(cros_handle->usage)) &&
+           dsa::readbackFormat(cros_handle->format, &format);
+}
+
+int MinigbmGralloc::readBackForCpu(const native_handle_t* handle) {
+    if (!wantsCpuReadback(handle)) {
+        return -EINVAL;
+    }
+    cros_gralloc_handle const* cros_handle = reinterpret_cast<cros_gralloc_handle const*>(handle);
+    dsa::ReadbackFormat format;
+    dsa::readbackFormat(cros_handle->format, &format);
+    const uint32_t width = cros_handle->width;
+    const uint32_t height = cros_handle->height;
+    if (width == 0 || height == 0) {
+        return 0;
+    }
+
+    const uint32_t hostHandle = getHostHandle(handle);
+    auto* rcEnc = renderControl();
+    if (hostHandle == 0 || !rcEnc) {
+        mesa_loge("%s: buffer %u has no host ColorBuffer to read back", __func__, cros_handle->id);
+        return -ENODEV;
+    }
+    // The whole ColorBuffer: the host reads no part of one.
+    std::vector<uint8_t> pixels(dsa::hostReadbackSize(format, width, height));
+    rcEnc->rcReadColorBuffer(rcEnc, hostHandle, 0, 0, static_cast<GLint>(width),
+                             static_cast<GLint>(height), format.glFormat, format.glType,
+                             pixels.data());
+
+    const int fd = cros_handle->fds[0];
+    const size_t offset = cros_handle->offsets[0];
+    const size_t stride = cros_handle->strides[0];
+    const size_t mapSize = cros_handle->total_size
+                               ? static_cast<size_t>(cros_handle->total_size)
+                               : offset + stride * height;
+    void* mapped = mmap(nullptr, mapSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (mapped == MAP_FAILED) {
+        const int error = errno;
+        mesa_loge("%s: cannot map buffer %u to write the GPU's drawing into it: %s", __func__,
+                  cros_handle->id, strerror(error));
+        return -error;
+    }
+    // A CPU that maps the buffer next sees these writes, whatever caches lie between.
+    struct dma_buf_sync sync = {DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE};
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    const bool copied =
+        offset <= mapSize &&
+        dsa::copyReadbackRows(pixels.data(), pixels.size(), format, width, height,
+                              static_cast<uint8_t*>(mapped) + offset, stride, mapSize - offset);
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    munmap(mapped, mapSize);
+    if (!copied) {
+        mesa_loge("%s: buffer %u (%ux%u, stride %zu) is smaller than its drawing", __func__,
+                  cros_handle->id, width, height, stride);
+        return -EINVAL;
+    }
+    return 0;
+}
+
 uint32_t MinigbmGralloc::getHostHandle(const AHardwareBuffer* ahb) {
     const native_handle_t* handle = AHardwareBuffer_getNativeHandle(ahb);
     return getHostHandle(handle);
