+void ResourceTracker::readBackForCpu(VkEncoder* enc, VkDevice device) {
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+    std::vector<AHardwareBuffer*> buffers;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        if (mCpuReadback.empty()) return;
+        // Each buffer stays alive while it is read, even if another thread frees its memory.
+        for (void* buffer : mCpuReadback.takePending((uint64_t)device)) {
+            AHardwareBuffer* ahb = static_cast<AHardwareBuffer*>(buffer);
+            AHardwareBuffer_acquire(ahb);
+            buffers.push_back(ahb);
+        }
+    }
+    if (buffers.empty()) return;
+    // The host answers once the device's work is done, so the ColorBuffers hold the drawing.
+    if (enc->vkDeviceWaitIdle(device, true /* do lock */) == VK_SUCCESS) {
+        for (AHardwareBuffer* ahb : buffers) {
+            mGralloc->readBackForCpu(mGralloc->getNativeHandle(ahb));
+        }
+    }
+    for (AHardwareBuffer* ahb : buffers) {
+        AHardwareBuffer_release(ahb);
+    }
+#else
+    (void)enc;
+    (void)device;
+#endif
+}
+
+void ResourceTracker::readBackImageForCpu(VkImage image) {
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+    const native_handle_t* handle = nullptr;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkImage.find(image);
+        if (it != info_VkImage.end()) handle = it->second.cpuReadbackHandle;
+    }
+    // The window system holds the buffer until the image is released to its consumer.
+    if (handle) mGralloc->readBackForCpu(handle);
+#else
+    (void)image;
+#endif
+}
