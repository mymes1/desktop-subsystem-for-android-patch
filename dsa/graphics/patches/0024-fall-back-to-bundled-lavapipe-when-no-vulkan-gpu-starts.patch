+std::vector<std::string> bundledSoftwareIcdCandidates() {
+#if defined(_WIN32)
+    const char* basename = "vulkan_lvp.dll";
+#elif defined(__APPLE__)
+    const char* basename = "libvulkan_lvp.dylib";
+#else
+    const char* basename = "libvulkan_lvp.so";
+#endif
+    std::vector<std::string> dirs = {
+        currentModuleDirectory(),
+        android::base::getProgramDirectory(),
+        android::base::getLauncherDirectory(),
+    };
+    std::vector<std::string> candidates;
+    for (const std::string& dir : dirs) {
+        if (dir.empty()) continue;
+        std::string full = pj({dir, basename});
+        bool seen = false;
+        for (const std::string& existing : candidates) {
+            if (existing == full) {
+                seen = true;
+                break;
+            }
+        }
+        if (!seen) {
+            candidates.push_back(std::move(full));
+        }
+    }
+    return candidates;
+}
