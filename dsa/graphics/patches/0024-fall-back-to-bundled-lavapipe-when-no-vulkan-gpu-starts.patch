+struct BundledIcdLookupContext {
+    PFN_vkGetInstanceProcAddr getInstanceProcAddr = nullptr;
+    VkInstance probeInstance = VK_NULL_HANDLE;
+};
+
+thread_local BundledIcdLookupContext* sBundledIcdLookup = nullptr;
+
+void* sBundledIcdDlOpen() { return sBundledIcdLookup; }
+
+void* sBundledIcdDlSym(void* lib, const char* sym) {
+    auto* ctx = static_cast<BundledIcdLookupContext*>(lib);
+    if (!ctx || !ctx->getInstanceProcAddr || !sym) {
+        return nullptr;
+    }
+    PFN_vkVoidFunction fn = ctx->getInstanceProcAddr(VK_NULL_HANDLE, sym);
+    if (!fn && ctx->probeInstance != VK_NULL_HANDLE) {
+        fn = ctx->getInstanceProcAddr(ctx->probeInstance, sym);
+    }
+    return reinterpret_cast<void*>(fn);
+}
