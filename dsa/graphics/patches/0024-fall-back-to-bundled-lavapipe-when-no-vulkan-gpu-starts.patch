+std::string currentModuleDirectory() {
+#ifdef _WIN32
+    HMODULE module = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&sVulkanDispatchImpl), &module) ||
+        !module) {
+        return "";
+    }
+    std::wstring widePath(MAX_PATH, L'\0');
+    DWORD copied = 0;
+    while (true) {
+        copied = GetModuleFileNameW(module, widePath.data(), static_cast<DWORD>(widePath.size()));
+        if (copied == 0) {
+            return "";
+        }
+        if (copied < widePath.size() - 1) {
+            widePath.resize(copied);
+            break;
+        }
+        widePath.resize(widePath.size() * 2);
+    }
+    int utf8Len = WideCharToMultiByte(CP_UTF8, 0, widePath.data(), static_cast<int>(widePath.size()),
+                                      nullptr, 0, nullptr, nullptr);
+    if (utf8Len <= 0) {
+        return "";
+    }
+    std::string utf8Path(static_cast<size_t>(utf8Len), '\0');
+    WideCharToMultiByte(CP_UTF8, 0, widePath.data(), static_cast<int>(widePath.size()),
+                        utf8Path.data(), utf8Len, nullptr, nullptr);
+    const size_t sep = utf8Path.find_last_of("\\/");
+    return sep == std::string::npos ? "" : utf8Path.substr(0, sep);
+#else
+    Dl_info info = {};
+    if (dladdr(reinterpret_cast<const void*>(&sVulkanDispatchImpl), &info) == 0 ||
+        !info.dli_fname) {
+        return "";
+    }
+    std::string path(info.dli_fname);
+    const size_t sep = path.find_last_of('/');
+    return sep == std::string::npos ? "" : path.substr(0, sep);
+#endif
+}
