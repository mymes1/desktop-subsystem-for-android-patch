diff --git a/net/vmw_vsock/Makefile b/net/vmw_vsock/Makefile
--- a/net/vmw_vsock/Makefile
+++ b/net/vmw_vsock/Makefile
@@ -2,9 +2,13 @@
 obj-$(CONFIG_VSOCKETS) += vsock.o
 obj-$(CONFIG_VSOCKETS_DIAG) += vsock_diag.o
 obj-$(CONFIG_VMWARE_VMCI_VSOCKETS) += vmw_vsock_vmci_transport.o
+# Only one guest-to-host transport may register, and built-in transports register in link
+# order. hv_sock comes first: it registers only when VMBus is present (a Hyper-V VM), and
+# otherwise steps aside for virtio's transport (Apple's Virtualization framework), so one
+# kernel reaches the host on both.
+obj-$(CONFIG_HYPERV_VSOCKETS) += hv_sock.o
 obj-$(CONFIG_VIRTIO_VSOCKETS) += vmw_vsock_virtio_transport.o
 obj-$(CONFIG_VIRTIO_VSOCKETS_COMMON) += vmw_vsock_virtio_transport_common.o
-obj-$(CONFIG_HYPERV_VSOCKETS) += hv_sock.o
 obj-$(CONFIG_VSOCKETS_LOOPBACK) += vsock_loopback.o

 vsock-y += af_vsock.o af_vsock_tap.o vsock_addr.o
