diff --git a/security/dsa_su/dsa_su.c b/security/dsa_su/dsa_su.c
new file mode 100644
index 0000000..a331d5b
--- /dev/null
+++ b/security/dsa_su/dsa_su.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DSA su guard: the su binary exists only for the Android uids the host has
+ * allowed. For any other task, a lookup, stat, access, open or exec of a
+ * watched su inode returns -ENOENT, so su is a file that is not there.
+ *
+ * The host's control daemon drives it through a single securityfs file,
+ * /sys/kernel/security/dsa_su/control, one command per line:
+ *
+ *   path <absolute path>   watch the inode at <absolute path> (the su binary)
+ *   allow <uid>            let this Android uid see the watched inodes
+ *   enable                 let the allowed uids see the watched inodes
+ *   disable                hide the watched inodes from every uid
+ *   reset                  forget every watched inode and allowed uid, and
+ *                          hide the watched inodes from every uid
+ *
+ * A watched inode is always hidden from a uid that is not allowed; with the
+ * guard disabled it is hidden from every uid. So turning root elevation off
+ * hides su from all, and never shows it to all.
+ *
+ * One write is one change: its commands apply to a copy of the guard's state,
+ * and the copy replaces the state only once every command has applied, so a
+ * reset followed by the paths and uids of a new config never shows su to
+ * anyone in between. A path that does not exist (the image keeps su at one of
+ * the watched paths, not at all of them) is skipped, and the rest of the write
+ * still applies. Any other command the guard refuses fails the whole write and
+ * leaves the state as it was.
+ *
+ * The file is written only by a task whose fsuid is root; SELinux policy
+ * restricts its label to the control daemon's domain, so no app can reach it.
+ * Nothing is looked up at run time outside this module.
+ */
+
+#include <linux/module.h>
+#include <linux/lsm_hooks.h>
+#include <linux/security.h>
+#include <linux/namei.h>
+#include <linux/fs.h>
+#include <linux/cred.h>
+#include <linux/uidgid.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/binfmts.h>
+#include <linux/path.h>
+#include <uapi/linux/lsm.h>
+
+/*
+ * The guard's LSM id, which the lsm_list_modules() syscall reports. It is not
+ * upstream, so it takes a value well above the ids <uapi/linux/lsm.h> hands
+ * out, where no upstream module will land.
+ */
+#define DSA_SU_LSM_ID 900
+
+static const struct lsm_id dsa_su_lsmid = {
+	.name = "dsa_su",
+	.id = DSA_SU_LSM_ID,
+};
+
+#define DSA_SU_MAX_INODES 8
+#define DSA_SU_MAX_UIDS 256
+
+struct dsa_su_inode {
+	dev_t dev;
+	unsigned long ino;
+};
+
+struct dsa_su_state {
+	bool enabled;
+	unsigned int inode_count;
+	struct dsa_su_inode inodes[DSA_SU_MAX_INODES];
+	unsigned int uid_count;
+	kuid_t uids[DSA_SU_MAX_UIDS];
+};
+
+static DEFINE_SPINLOCK(dsa_su_lock);
+static struct dsa_su_state dsa_su_state;
+
+/*
+ * -ENOENT when the inode is a watched su and the current task may not see it:
+ * the guard is disabled, or the task's fsuid is not allowed. Called from hooks.
+ */
+static int dsa_su_check_inode(const struct inode *inode)
+{
+	kuid_t uid = current_fsuid();
+	bool watched = false;
+	bool allowed = false;
+	unsigned int i;
+
+	if (!inode)
+		return 0;
+	spin_lock(&dsa_su_lock);
+	for (i = 0; i < dsa_su_state.inode_count; i++) {
+		if (dsa_su_state.inodes[i].dev == inode->i_sb->s_dev &&
+		    dsa_su_state.inodes[i].ino == inode->i_ino) {
+			watched = true;
+			break;
+		}
+	}
+	if (watched && dsa_su_state.enabled) {
+		for (i = 0; i < dsa_su_state.uid_count; i++) {
+			if (uid_eq(dsa_su_state.uids[i], uid)) {
+				allowed = true;
+				break;
+			}
+		}
+	}
+	spin_unlock(&dsa_su_lock);
+	if (!watched || allowed)
+		return 0;
+	return -ENOENT;
+}
+
+static int dsa_su_inode_permission(struct inode *inode, int mask)
+{
+	return dsa_su_check_inode(inode);
+}
+
+static int dsa_su_inode_getattr(const struct path *path)
+{
+	return dsa_su_check_inode(d_backing_inode(path->dentry));
+}
+
+static int dsa_su_file_open(struct file *file)
+{
+	return dsa_su_check_inode(file_inode(file));
+}
+
+static int dsa_su_bprm_creds_for_exec(struct linux_binprm *bprm)
+{
+	if (!bprm->file)
+		return 0;
+	return dsa_su_check_inode(file_inode(bprm->file));
+}
+
+static struct security_hook_list dsa_su_hooks[] __ro_after_init = {
+	LSM_HOOK_INIT(inode_permission, dsa_su_inode_permission),
+	LSM_HOOK_INIT(inode_getattr, dsa_su_inode_getattr),
+	LSM_HOOK_INIT(file_open, dsa_su_file_open),
+	LSM_HOOK_INIT(bprm_creds_for_exec, dsa_su_bprm_creds_for_exec),
+};
+
+/* Watches the inode at name in next. A path that does not exist is skipped. */
+static int dsa_su_add_path(struct dsa_su_state *next, const char *name)
+{
+	struct path path;
+	struct inode *inode;
+	unsigned int i;
+	int err;
+
+	err = kern_path(name, LOOKUP_FOLLOW, &path);
+	if (err == -ENOENT || err == -ENOTDIR)
+		return 0;
+	if (err)
+		return err;
+	inode = d_backing_inode(path.dentry);
+	if (!inode) {
+		path_put(&path);
+		return 0;
+	}
+	for (i = 0; i < next->inode_count; i++) {
+		if (next->inodes[i].dev == inode->i_sb->s_dev &&
+		    next->inodes[i].ino == inode->i_ino) {
+			path_put(&path);
+			return 0;
+		}
+	}
+	if (next->inode_count >= DSA_SU_MAX_INODES) {
+		path_put(&path);
+		return -ENOSPC;
+	}
+	next->inodes[next->inode_count].dev = inode->i_sb->s_dev;
+	next->inodes[next->inode_count].ino = inode->i_ino;
+	next->inode_count++;
+	path_put(&path);
+	return 0;
+}
+
+static int dsa_su_add_uid(struct dsa_su_state *next, const char *digits)
+{
+	unsigned int value;
+	kuid_t uid;
+	int err;
+
+	err = kstrtouint(digits, 10, &value);
+	if (err)
+		return err;
+	uid = make_kuid(current_user_ns(), value);
+	if (!uid_valid(uid))
+		return -EINVAL;
+	if (next->uid_count >= DSA_SU_MAX_UIDS)
+		return -ENOSPC;
+	next->uids[next->uid_count++] = uid;
+	return 0;
+}
+
+static int dsa_su_command(struct dsa_su_state *next, char *line)
+{
+	char *arg;
+
+	arg = strchr(line, ' ');
+	if (arg)
+		*arg++ = '\0';
+	while (arg && *arg == ' ')
+		arg++;
+	if (arg)
+		arg = strim(arg);
+
+	if (!strcmp(line, "enable")) {
+		next->enabled = true;
+		return 0;
+	}
+	if (!strcmp(line, "disable")) {
+		next->enabled = false;
+		return 0;
+	}
+	if (!strcmp(line, "reset")) {
+		next->enabled = false;
+		next->inode_count = 0;
+		next->uid_count = 0;
+		return 0;
+	}
+	if (!strcmp(line, "path") && arg && *arg)
+		return dsa_su_add_path(next, arg);
+	if (!strcmp(line, "allow") && arg && *arg)
+		return dsa_su_add_uid(next, arg);
+	return -EINVAL;
+}
+
+static ssize_t dsa_su_control_write(struct file *file, const char __user *buf,
+				    size_t count, loff_t *ppos)
+{
+	struct dsa_su_state *next;
+	char *kbuf, *line, *rest;
+	ssize_t ret = count;
+
+	/* Only root may drive the guard; SELinux restricts the file's label on
+	 * top of this to the control daemon's domain. */
+	if (!uid_eq(current_fsuid(), GLOBAL_ROOT_UID))
+		return -EPERM;
+	if (count == 0 || count > PAGE_SIZE)
+		return -EINVAL;
+	kbuf = memdup_user_nul(buf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+	next = kmalloc(sizeof(*next), GFP_KERNEL);
+	if (!next) {
+		kfree(kbuf);
+		return -ENOMEM;
+	}
+	spin_lock(&dsa_su_lock);
+	*next = dsa_su_state;
+	spin_unlock(&dsa_su_lock);
+
+	rest = kbuf;
+	while ((line = strsep(&rest, "\n")) != NULL) {
+		int err;
+
+		if (*line == '\0')
+			continue;
+		err = dsa_su_command(next, line);
+		if (err) {
+			ret = err;
+			break;
+		}
+	}
+	if (ret >= 0) {
+		spin_lock(&dsa_su_lock);
+		dsa_su_state = *next;
+		spin_unlock(&dsa_su_lock);
+	}
+	kfree(next);
+	kfree(kbuf);
+	return ret;
+}
+
+static const struct file_operations dsa_su_control_fops = {
+	.write = dsa_su_control_write,
+	.llseek = noop_llseek,
+};
+
+static int __init dsa_su_securityfs_init(void)
+{
+	struct dentry *dir;
+
+	dir = securityfs_create_dir("dsa_su", NULL);
+	if (IS_ERR(dir))
+		return PTR_ERR(dir);
+	if (IS_ERR(securityfs_create_file("control", 0200, dir, NULL,
+					  &dsa_su_control_fops)))
+		return -ENOMEM;
+	return 0;
+}
+fs_initcall(dsa_su_securityfs_init);
+
+static int __init dsa_su_init(void)
+{
+	security_add_hooks(dsa_su_hooks, ARRAY_SIZE(dsa_su_hooks), &dsa_su_lsmid);
+	pr_info("dsa_su: su guard ready (watching nothing until the control daemon names su)\n");
+	return 0;
+}
+
+DEFINE_LSM(dsa_su) = {
+	.name = "dsa_su",
+	.init = dsa_su_init,
+};
