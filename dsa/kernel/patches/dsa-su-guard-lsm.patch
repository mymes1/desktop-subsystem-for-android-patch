diff --git a/security/dsa_su/Kconfig b/security/dsa_su/Kconfig
new file mode 100644
index 0000000..3819854
--- /dev/null
+++ b/security/dsa_su/Kconfig
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: GPL-2.0
+config DSA_SU_GUARD
+	bool "DSA su guard (per-uid visibility of the su binary)"
+	depends on SECURITY && SECURITYFS
+	default n
+	help
+	  Makes the su binary of the Desktop Subsystem for Android image exist
+	  only for the Android uids the host has allowed. For any other task a
+	  lookup, stat, access, open or exec of a watched su inode returns
+	  -ENOENT, so su is a file that is not there.
+
+	  The host's control daemon drives it through
+	  /sys/kernel/security/dsa_su/control: it names the su inode(s) to
+	  watch, the uids that may see them, and whether the guard is on. With
+	  the guard off, or with no uid allowed, su is hidden from every task.
+	  Nothing is looked up at run time outside this module, and the module
+	  is built in, so the image ships no kernel module for it. It must be
+	  named in CONFIG_LSM (before selinux, so a hidden su is ENOENT rather
+	  than a SELinux denial), or it never initialises.
+
+	  Unless you are building the DSA guest kernel, say N.
