 /*
+ * Writes the disk GUID from the GPT header into guid, or an empty string when the disk
+ * has no GPT. A disk's kernel name follows probe order, which a hypervisor attaching
+ * several disks does not keep stable; the GUID is written into the disk itself.
+ */
+static void cmdline_disk_guid(struct parsed_partitions *state, char *guid)
+{
+	unsigned int lba_sectors = queue_logical_block_size(state->disk->queue) >> 9;
+	Sector sect;
+	unsigned char *header;
+
+	guid[0] = '\0';
+	header = read_part_sector(state, lba_sectors, &sect);
+	if (!header)
+		return;
+	if (!memcmp(header, "EFI PART", 8))
+		snprintf(guid, UUID_STRING_LEN + 1, "%pUl", header + 56);
+	put_dev_sector(sect);
+}
