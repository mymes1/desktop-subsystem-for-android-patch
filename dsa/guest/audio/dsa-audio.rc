# The guest's primary audio module, which plays the guest's sound on the host's default
# output device and records from its default capture device. audioserver holds its streams,
# so a restart of the module restarts it too.
service vendor.dsa-audio /vendor/bin/hw/dsa-audio
    class hal
    user audioserver
    group audio
    capabilities SYS_NICE
    # Lets binder priority inheritance reach the stream threads.
    rlimit rtprio 10 10
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart audioserver
