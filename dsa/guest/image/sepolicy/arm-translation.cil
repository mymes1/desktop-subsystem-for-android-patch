; Desktop Subsystem for Android (DSA)
; ARM app translation (dsa-arm-translation.rc). When the host says translation is on, init
; mounts a package's erofs image straight from its file at /mnt/dsa-arm-translation, its files
; labelled as system libraries: the user's package from /data/vendor/dsa/arm-translation, or
; the image's default one from /system/etc/dsa (system_file, which init already reads). It
; then binds the image's folders onto the empty folders the x86_64 image carries for them
; (/system_ext/lib64 and /system/lib64/arm64, system libraries; /system/bin/arm64 and
; /system/bin/dsa-arm-translation, system files) and its linker configuration onto the empty
; /system/etc/ld.config.arm64.txt, and the translator's exec region library onto the empty
; /system/lib64/libberberis_exec_region.so (a system library). Nothing is laid over a folder the system's own programs
; are in. It mounts binfmt_misc on /proc/sys/fs/binfmt_misc, which nothing else in Android
; mounts, and registers the package's handlers there.
; erofs opens the image file with init's credentials as init mounts it, and reads it with them
; afterwards, so reading the file is all init needs; there is no loop device to open.
(allow init vendor_data_file (file (read open getattr)))
(allow init tmpfs (dir (mounton)))
(allow init system_file (dir (mounton)))
(allow init system_lib_file (dir (mounton)))
(allow init system_linker_config_file (file (mounton)))
(allow init system_lib_file (file (mounton)))

; The image's superblock. statfs on each folder the image is bound onto reports the image's
; superblock, and the kernel checks the caller's filesystem getattr against its label. So
; every program that asks how full one of them is, and init itself, are checked against this
; type. As an fs_type it is covered by the platform's "allow domain fs_type:filesystem getattr",
; as /system's own labeledfs is, so no domain needs a rule of its own. It is a
; contextmount_type because the platform forbids relabelling a superblock to any other
; fs_type; the platform keeps such types read-only, and nothing writes to the image.
(type dsa_arm_translation_fs)
(roletype object_r dsa_arm_translation_fs)
(typeattributeset fs_type (dsa_arm_translation_fs))
(typeattributeset contextmount_type (dsa_arm_translation_fs))
; init mounts the image with fscontext=dsa_arm_translation_fs and context=system_lib_file. The
; kernel relabels the superblock from erofs's own type (relabelfrom labeledfs, relabelto the
; image's type); labels every file system_lib_file, the root first (relabelfrom the image's
; type, and system_lib_file associates with it); and then checks the mount against the image's
; type. system_lib_file is a file type, not an fs_type, so the platform's neverallow on an
; fs_type associating with a file type does not reach it.
(allow init labeledfs (filesystem (relabelfrom)))
(allow init dsa_arm_translation_fs (filesystem (mount relabelfrom relabelto)))
(allow system_lib_file dsa_arm_translation_fs (filesystem (associate)))
(allow init proc (dir (mounton)))
(allow init binfmt_miscfs (filesystem (mount)))
(allow init binfmt_miscfs (file (write open getattr)))
