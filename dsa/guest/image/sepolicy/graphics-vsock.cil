; Desktop Subsystem for Android (DSA)
; Allows app domains, surfaceflinger, and graphics HAL servers to create and
; connect AF_VSOCK sockets to the host graphics remoting ports.

(allow appdomain self (vsock_socket (create connect read write getattr setopt getopt shutdown)))
(allow surfaceflinger self (vsock_socket (create connect read write getattr setopt getopt shutdown)))
(allow hal_graphics_allocator_server self (vsock_socket (create connect read write getattr setopt getopt shutdown)))
(allow hal_graphics_composer_server self (vsock_socket (create connect read write getattr setopt getopt shutdown)))
(allow bootanim self (vsock_socket (create connect read write getattr setopt getopt shutdown)))

; The allocator (minigbm) allocates buffers on the guest's DRM device, which is
; vgem under Hyper-V and labelled graphics_device, not the gpu_device the
; Cuttlefish policy grants it.
(allow hal_graphics_allocator_server graphics_device (dir (search)))
(allow hal_graphics_allocator_server graphics_device (chr_file (open read write ioctl getattr map)))

; The DRM cards are relabelled gpu_device so every graphics client may open them. Cuttlefish's
; init script waits for /dev/dri/card0 as vendor_init, which may check only graphics_device.
; Refused, the wait times out after five seconds and holds up early boot.
(allow vendor_init gpu_device (chr_file (getattr)))
