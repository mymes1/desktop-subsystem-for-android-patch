<!-- The sensors HAL dsa-sensors serves. Version 2 is in the compatibility matrix of every
     supported image. -->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.sensors</name>
        <version>2</version>
        <fqname>ISensors/default</fqname>
    </hal>
</manifest>
