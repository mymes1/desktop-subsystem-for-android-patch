<?xml version="1.0" encoding="utf-8"?>
<!--
  The media probe: an ordinary third-party app, with no permission and no activity, whose one
  instrumentation plays sound and runs codecs in its own process, as any app would. The image
  boot check installs it and runs it with SELinux enforcing (dsa/host/platform/linux/tests/
  media.rs): an app's process runs in the untrusted app domain at an MLS level of its own,
  which is what the platform's own media services do not test.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.thisisthepy.dsa.mediaprobe">

    <application android:label="DSA media probe" android:hasCode="true" />

    <instrumentation
        android:name=".MediaProbe"
        android:targetPackage="io.github.thisisthepy.dsa.mediaprobe"
        android:label="DSA media probe" />
</manifest>
